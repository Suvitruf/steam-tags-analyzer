{
  "name": "steam-tags-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based Steam tag recommendations, tag audits, and game-market analytics.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config sources/vite.config.ts",
    "typecheck": "tsc --noEmit -p sources/tsconfig.json",
    "build:web": "vite build --config sources/vite.config.ts",
    "build:site": "npm run build:tags && bundle exec jekyll build",
    "check:site": "node tools/check-site.mjs && node tools/check-tag-pages.mjs",
    "build": "npm run test:tag-pages && npm run typecheck && npm run build:web && npm run build:site && npm run check:site",
    "preview": "bundle exec jekyll serve --skip-initial-build --host 127.0.0.1",
    "build:tags": "node tools/generate-tag-pages.mjs",
    "test:tag-pages": "node --test tools/tests/tag-pages.test.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "2.17.2",
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vite": "6.4.2"
  }
}
